{
  "name": "vaulty",
  "version": "1.0.0-alpha.1",
  "main": "src/app.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "release:android": "expo prebuild -p android && expo run:android --variant release",
    "release:ios": "expo prebuild -p ios && expo run:ios --configuration Release",
    "test": "jest",
    "lint:fix": "eslint . --fix",
    "lint:type": "tsc --noEmit",
    "lint": "npm run lint:fix && npm run lint:type"
  },
  "dependencies": {
    "@craftzdog/react-native-buffer": "^6.0.5",
    "@gorhom/bottom-sheet": "^5.1.2",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "^7.0.19",
    "@react-navigation/native-stack": "^7.3.3",
    "@shopify/flash-list": "^2.0.2",
    "expo": "^52.0.41",
    "expo-application": "~6.0.2",
    "expo-build-properties": "~0.13.2",
    "expo-clipboard": "~7.0.1",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-navigation-bar": "~4.0.8",
    "expo-notifications": "~0.29.14",
    "expo-screen-capture": "~7.0.1",
    "expo-secure-store": "~14.0.1",
    "expo-sharing": "~13.0.1",
    "expo-splash-screen": "~0.29.22",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.8",
    "fuse.js": "^7.0.0",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-mmkv": "^3.2.0",
    "react-native-quick-base64": "^2.1.2",
    "react-native-quick-crypto": "^0.7.12",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-udp": "^4.1.7",
    "zod": "^3.23.8",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "~5.3.3"
  },
  "overrides": {
    "readable-stream": "^3.6.2"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "@craftzdog/react-native-buffer",
          "react-native-udp"
        ]
      }
    }
  }
}
